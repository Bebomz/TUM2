<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.title ? title + ' · ' : '' %>Trouver un marchand</title>
  <meta name="description" content="Trouvez les marchands ambulants près de chez vous sur une carte, par catégorie et par jour de la semaine.">
  <meta name="theme-color" content="#ff6b35">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <% if (locals.leaflet) { %><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><% } %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= locals.bodyClass || '' %>">
<header class="site-header">
  <a class="logo" href="/"><span class="logo-mark">📍</span><span class="logo-text">Trouver<b>unmarchand</b></span></a>
  <nav>
    <a href="/">Carte</a>
    <a href="/soutenir">Soutenir</a>
    <% if (user) { %>
      <a href="<%= user.role === 'admin' ? '/admin' : '/espace' %>"><%= user.role === 'admin' ? 'Admin' : 'Mon espace' %></a>
      <form action="/deconnexion" method="post" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn" type="submit">Déconnexion</button></form>
    <% } else { %>
      <a href="/connexion">Connexion</a>
      <a class="btn btn-sm" href="/inscription">Je suis marchand</a>
    <% } %>
  </nav>
</header>
<% if (flash) { %><div class="toast <%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
