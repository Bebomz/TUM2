<%- include('head') %>
<main class="container narrow">
  <h1>Nouveau mot de passe</h1>
  <% if (locals.error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/reinitialisation/<%= token %>" class="card form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nouveau mot de passe <input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
    <label>Confirmation <input type="password" name="password2" minlength="8" required autocomplete="new-password"></label>
    <button class="btn" type="submit">Enregistrer</button>
  </form>
</main>
<%- include('footer') %>
<%- include('foot') %>
