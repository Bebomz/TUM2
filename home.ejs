<%- include('head', { leaflet: true, bodyClass: 'page-map' }) %>
<div class="map-page">
  <div id="map" aria-label="Carte des marchands"></div>

  <div class="filters" id="filters">
    <button class="filters-toggle" id="filtersToggle" type="button" aria-expanded="false">
      <span>⚙️ Filtres</span><span class="filter-summary" id="filterSummary"></span>
    </button>
    <div class="filters-body" id="filtersBody">
      <div class="search-row">
        <input id="placeInput" type="search" placeholder="Ville ou adresse…" autocomplete="off">
        <button id="placeBtn" type="button" class="btn btn-sm">Aller</button>
      </div>
      <div class="row2">
        <label>Jour
          <select id="daySelect">
            <option value="0">Tous les jours</option>
            <% days.forEach(function (d, i) { if (i > 0) { %><option value="<%= i %>"><%= d %></option><% } }) %>
          </select>
        </label>
        <label>Distance
          <select id="radiusSelect">
            <option value="2">2 km</option>
            <option value="5">5 km</option>
            <option value="10" selected>10 km</option>
            <option value="25">25 km</option>
            <option value="50">50 km</option>
            <option value="0">Partout</option>
          </select>
        </label>
      </div>
      <div class="chips-title">Catégories <button type="button" id="clearCats" class="link-btn small">Tout afficher</button></div>
      <div class="chips" id="chips"></div>
    </div>
  </div>

  <button id="locateBtn" class="fab" type="button" title="Autour de moi" aria-label="Autour de moi">📍</button>
  <div id="resultPill" class="pill" role="status">Chargement…</div>
</div>

<div id="reportModal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="reportTitle">
  <div class="modal-box">
    <h2 id="reportTitle">🚩 Signaler une absence</h2>
    <p class="muted small" id="reportIntro"></p>
    <form id="reportForm" class="form">
      <fieldset id="reportSessions" class="report-sessions"></fieldset>
      <label>Précision (facultatif)
        <textarea name="comment" rows="2" maxlength="300" placeholder="Ex. Personne sur place, stand fermé…"></textarea>
      </label>
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <p id="reportMsg" class="small" role="status"></p>
      <div class="modal-actions">
        <button type="button" class="btn btn-light" id="reportCancel">Annuler</button>
        <button type="submit" class="btn" id="reportSend">Envoyer le signalement</button>
      </div>
    </form>
  </div>
</div>

<script>window.CATEGORIES = <%- categoriesJson %>; window.CSRF = <%- JSON.stringify(csrfToken) %>;</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/map.js"></script>
<%- include('foot') %>
